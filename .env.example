# Copy to .env in the application directory.
# Loopback endpoints assume Veriquery, MinerU and Xinference run on the same host.
DEBUG=false
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
NO_PROXY=localhost,127.0.0.1

# Use the model UIDs reported by Xinference GET /v1/models.
# Preview the configured UIDs with python scripts/check_xinference.py.
XINFERENCE_API_BASE=http://127.0.0.1:9997/v1
XINFERENCE_API_KEY=
XINFERENCE_TIMEOUT=120
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
RERANK_MODEL=bge-reranker-v2-m3
XINFERENCE_LLM_MODEL=qwen3.5
XINFERENCE_VLM_MODEL=qwen3.5-2b

# Enable only after validating the parser contract against the deployed service.
USE_MINERU_PARSE=true
MINERU_API_BASE=http://127.0.0.1:8001
MINERU_API_KEY=
MINERU_TIER=advanced
MINERU_TIMEOUT=1800
MINERU_ALLOW_LOCAL_FALLBACK=false
MINERU_VERIFY_TABLE_COLUMNS=true

# Start with text and table validation. Local image classification may still
# run during the PyMuPDF fallback.
VISUAL_PIPELINE_ENABLED=false
USE_XINFERENCE_VLM=true
USE_XINFERENCE_VL_EMBEDDING=false
VL_IMAGE_ENCODING_AVAILABLE=false
VL_EMBEDDING_MODEL=Qwen3-VL-Embedding-2B
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_THRESHOLD=0.25

# Run from the project directory. Set both paths when mapping a new data root.
DATA_DIR_STR=./data
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=veriquery_text
CHUNK_SIZE=500
CHUNK_OVERLAP=100
VECTOR_WEIGHT=0.50
BM25_WEIGHT=0.35
STRUCTURED_WEIGHT=0.15

# Optional eval/run_eval.py settings. A blank Judge base follows Xinference.
EVAL_API_BASE=http://127.0.0.1:8000
EVAL_TRACE_ENABLED=false
RAG_FOCUS_TABLE_EVIDENCE=true
RAG_BALANCED_COMPARISON=true
RAG_CITATION_REPAIR=true
RAG_VERIFIED_PASSAGES=true
RAG_CONDITION_EVIDENCE=true
RAG_EXACT_GAIN_EVIDENCE=true
RAG_EVIDENCE_COVERAGE=false
RAG_JOINT_COMPARISON=true
EVAL_JUDGE_BASE=
EVAL_JUDGE_MODEL=qwen3.5-2b
EVAL_JUDGE_KEY=
